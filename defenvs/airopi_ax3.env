bootdev=nor
baudrate=115200
loadaddr=50000000
ipaddr=192.168.1.1
serverip=192.168.1.254
ethaddr=aa:bb:cc:dd:ee:ff
file_bl2=preloader.bin
file_fip=bl31-uboot.fip
file_fw=firmware.itb
file_ik=initramfs-kernel.bin
file_img=sdcard.img
bootargs=root=/dev/fit0 rootwait
bootcmd=test "$bootdev" = mmc && run mmc_read_fw && bootm "$loadaddr$bootconf_mmc"; run nor_read_fw && bootm "$loadaddr"
bootconf_mmc=#config-1#mt7981b-airopi-ax3-sdcard
bootmenu_0=[1m[36mExec default boot command[0m=run bootcmd; echo [1m[35mBoot failed![0m; sleep 3; reset
bootmenu_1=[1m[36mBoot system from Flash[0m=run bootcmd; echo [1m[35mBoot failed![0m; pause; bootmenu 60
bootmenu_2=[1m[32mLoad initramfs image via TFTP then boot[0m=run tftp_boot_ik; pause; bootmenu 60
bootmenu_3=[1m[32mLoad system via TFTP then write to Flash[0m=run tftp_update_fw; pause; bootmenu 60
bootmenu_4=[1m[33mLoad BL2 via TFTP then write to Flash[0m=run tftp_update_bl2; pause; bootmenu 60
bootmenu_5=[1m[33mLoad FIP via TFTP then write to Flash[0m=run tftp_update_fip; pause; bootmenu 60
bootmenu_6=[1m[31mSwitch boot device[0m=run switch_bootdev; pause; bootmenu 60
bootmenu_7=[1m[31mReboot[0m=reset
check_bl2_integrity=if run md5_verify_bl2; then echo [1m[32mBL2 upgrade successful![0m; else echo [1m[31mBL2 upgrade failed![0m; fi
check_fip_integrity=if run md5_verify_fip; then echo [1m[32mFIP upgrade successful![0m; else echo [1m[31mFIP upgrade failed![0m; fi
continue_or_not=askenv char [1m[33mContinue? [Y/n][0m 1 && test "$char" = y -o "$char" = Y
initcmd=run set_macaddr && setenv set_macaddr && setenv initcmd
md5_verify_bl2=md5sum "$loadaddr" "$filesize" sum && mtd read bl2 "$loadaddr" && md5sum -v "$loadaddr" "$filesize" "$sum"
md5_verify_fip=md5sum "$loadaddr" "$filesize" sum && mtd read fip "$loadaddr" && md5sum -v "$loadaddr" "$filesize" "$sum"
mmc_prep_write=setexpr ioblks "$filesize" + 1ff && setexpr ioblks "$ioblks" / 200
mmc_read_fw=part start mmc 0 fit fitaddr && mmc read "$loadaddr" "$fitaddr" 8 && imszb "$loadaddr" ioblks && mmc read "$loadaddr" "$fitaddr" "$ioblks"
mmc_write_fw=part start mmc 0 fit fitaddr && run mmc_prep_write && mmc write "$loadaddr" "$fitaddr" "$ioblks"
nor_prep_erase=setexpr iosize "$filesize" + ffff && setexpr iosize "$iosize" / 10000 && setexpr iosize "$iosize" * 10000
nor_read_fw=mtd read firmware "$loadaddr" 0 1000 && imsz "$loadaddr" iosize && mtd read firmware "$loadaddr" 0 "$iosize"
nor_write_fw=run nor_prep_erase && mtd erase firmware 0 "$iosize" && mtd write firmware "$loadaddr" 0 "$filesize"
set_macaddr=mw.l "$loadaddr" 00430c00 && setexpr ptr "$loadaddr" + 3 && cp.b 11f20140 "$ptr" 3 && setenv ptr && readmem -b ethaddr "$loadaddr"
setup_netcon=setenv ncip "$serverip" && for dev in stdin stdout stderr; do setenv "$dev" nc; done && setenv bootdelay 60
setup_uartcon=for dev in stderr stdout stdin; do setenv "$dev" serial@11002000; done && setenv ncip && setenv bootdelay
switch_bootdev=if test "$bootdev" = mmc; then setenv bootdev nor && echo [1m[33mNOR selected![0m; else setenv bootdev mmc && echo [1m[33mMMC selected![0m; fi && saveenv
switch_console=if test "$stdin" = nc; then run setup_uartcon; else run setup_netcon; fi
tftp_boot_ik=test "$bootdev" = mmc && conf="$bootconf_mmc" || conf=""; while true; do tftpboot "$loadaddr" "$file_ik" && bootm "$loadaddr$conf"; sleep 3; done
tftp_update_bl2=tftpboot "$loadaddr" "$file_bl2" && run continue_or_not && mtd erase bl2 && mtd write bl2 "$loadaddr" 0 "$filesize" && run check_bl2_integrity
tftp_update_fip=tftpboot "$loadaddr" "$file_fip" && run continue_or_not && mtd erase fip && mtd write fip "$loadaddr" 0 "$filesize" && run check_fip_integrity
tftp_update_fw=while true; do run tftp_write_fw && run bootcmd; run tftp_write_img && run bootcmd; sleep 3; done
tftp_write_fw=tftpboot "$loadaddr" "$file_fw" && if test "$bootdev" = mmc; then run mmc_write_fw; else run nor_write_fw; fi
tftp_write_img=tftpboot "$loadaddr" "$file_img" && run mmc_prep_write && mmc write "$loadaddr" 0 "$ioblks"
