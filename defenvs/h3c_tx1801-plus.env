bootmeth=ubi
baudrate=115200
loadaddr=88000000
ipaddr=192.168.1.1
serverip=192.168.1.254
ethaddr=aa:bb:cc:dd:ee:ff
file_bl=u-boot.bin
file_fw=firmware.bin
file_ik=initramfs-kernel.bin
bootcmd=if test "$bootmeth" = ubi; then run ubi_read_fw; else run nand_read_fw; fi && bootm "$loadaddr"
bootmenu_0=[1m[36mExec default boot command[0m=run bootcmd; echo [1m[35mBoot failed![0m; sleep 3; reset
bootmenu_1=[1m[36mBoot system from Flash[0m=run bootcmd; echo [1m[35mBoot failed![0m; pause; bootmenu 60
bootmenu_2=[1m[32mLoad initramfs image via TFTP then boot[0m=run tftp_boot_ik; pause; bootmenu 60
bootmenu_3=[1m[32mLoad system via TFTP then write to Flash[0m=run tftp_update_fw; pause; bootmenu 60
bootmenu_4=[1m[33mLoad U-Boot via TFTP then write to Flash[0m=run tftp_update_bl; pause; bootmenu 60
bootmenu_5=[1m[33mLoad U-Boot via UART then write to Flash[0m=run uart_update_bl; pause; bootmenu 60
bootmenu_6=[1m[31mSwitch boot method[0m=run switch_bootmeth; pause; bootmenu 60
bootmenu_7=[1m[31mReboot[0m=reset
check_bl_integrity=if run md5_verify_bl; then echo [1m[32mU-Boot upgrade successful![0m; else echo [1m[31mU-Boot upgrade failed![0m; fi
check_itbimg=imsz "$loadaddr" itbsize && setexpr itbsize "$itbsize" + 80000 && test "$itbsize" -gt "$filesize"
continue_or_not=askenv char [1m[33mContinue? [Y/n][0m 1 && test "$char" = y -o "$char" = Y
initcmd=run set_macaddr && setenv set_macaddr && setenv initcmd
md5_verify_bl=md5sum "$loadaddr" "$filesize" sum && mtd read u-boot "$loadaddr" && md5sum -v "$loadaddr" "$filesize" "$sum"
nand_prep_erase=setexpr iosize "$filesize" + 1ffff && setexpr iosize "$iosize" / 20000 && setexpr iosize "$iosize" * 20000
nand_prep_read=setexpr iosize "$iosize" + 7ff && setexpr iosize "$iosize" / 800 && setexpr iosize "$iosize" * 800
nand_prep_write=setexpr iosize "$filesize" + 7ff && setexpr iosize "$iosize" / 800 && setexpr iosize "$iosize" * 800
nand_read_fw=mtd read ubi "$loadaddr" 0 1000 && imsz "$loadaddr" iosize && run nand_prep_read && mtd read ubi "$loadaddr" 0 "$iosize"
nand_write_bl=run continue_or_not && mtd erase u-boot && run nand_prep_write && mtd write u-boot "$loadaddr" 0 "$iosize"
nand_write_fw=ubi detach && run nand_prep_erase && mtd erase ubi 0 "$iosize" && run nand_prep_write && mtd write ubi "$loadaddr" 0 "$iosize"
set_macaddr=mtd read u-boot-env "$loadaddr" && ms.s -q -l1 "$loadaddr" 80000 ethaddr= && setexpr memaddr "$memaddr" + 8 && readmem ethaddr "$memaddr" 11 && setenv memaddr && setenv memmatches && setenv mempos
setup_netcon=setenv ncip "$serverip" && for dev in stdin stdout stderr; do setenv "$dev" nc; done && setenv bootdelay 60
setup_uartcon=for dev in stderr stdout stdin; do setenv "$dev" serial@1e000c00; done && setenv ncip && setenv bootdelay
switch_bootmeth=if test "$bootmeth" = ubi; then setenv bootmeth mtd && echo [1m[33mMTD selected![0m; else setenv bootmeth ubi && echo [1m[33mUBI selected![0m; fi && saveenv
switch_console=if test "$stdin" = nc; then run setup_uartcon; else run setup_netcon; fi
tftp_boot_ik=while true; do tftpboot "$loadaddr" "$file_ik" && bootm "$loadaddr"; sleep 3; done
tftp_update_bl=mw.b "$loadaddr" ff 80000 && tftpboot "$loadaddr" "$file_bl" && run nand_write_bl && run check_bl_integrity
tftp_update_fw=while true; do tftpboot "$loadaddr" "$file_fw" && run tftp_write_fw && run bootcmd; sleep 3; done
tftp_write_fw=if test "$bootmeth" = ubi && run check_itbimg; then run ubi_write_fw; else run nand_write_fw; fi
uart_update_bl=mw.b "$loadaddr" ff 80000 && loadx "$loadaddr" "$baudrate" && sleep 3 && run nand_write_bl && run check_bl_integrity
ubi_erase_userdata=ubi part ubi && ubi check rootfs_data && ubi remove rootfs_data && ubi create rootfs_data - dynamic && reset
ubi_prep_write=setexpr volsize "$filesize" + 1efff && setexpr volsize "$volsize" / 1f000 && setexpr volsize "$volsize" * 1f000
ubi_read_fw=ubi part ubi && if ubi check kernel; then ubi read "$loadaddr" kernel; else ubi read "$loadaddr" fit; fi
ubi_write_fw=ubi detach && mtd erase ubi && ubi part ubi && run ubi_prep_write && ubi create fit "$volsize" dynamic && ubi write "$loadaddr" fit "$filesize"
